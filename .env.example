# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Alpaca API keys. Use PAPER keys: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Stock data feed: iex (free) or sip (paid subscription)
ALPACA_STOCK_FEED=iex
# Stock price adjustment: split (default; removes split jumps), all (also
# dividends), dividend, or raw
ALPACA_ADJUSTMENT=split

# --- Safety switches ---------------------------------------------------
# Orders are placed ONLY when all three are set exactly like this:
#   ALPACA_PAPER=true, TRADING_MODE=paper, PLACE_ORDERS=true
# With ALPACA_PAPER=false the app never creates a trading client at all.
ALPACA_PAPER=true
TRADING_MODE=alerts_only
PLACE_ORDERS=false

# --- Risk --------------------------------------------------------------
# Skip BUY signals while this many positions are open (empty/0: no limit)
MAX_OPEN_POSITIONS=

# --- Notifications -----------------------------------------------------
# Create a bot with @BotFather, then message it and read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Also notify when there is nothing to do (noisy)
NOTIFY_HOLD=false

# --- Defaults ----------------------------------------------------------
DATABASE_PATH=data/trading_pipeline.sqlite3
WATCHLIST_PATH=watchlist.toml
DEFAULT_SYMBOL=AAPL
DEFAULT_ASSET_CLASS=stock
DEFAULT_TIMEFRAME=1Day
DEFAULT_STRATEGY=sma_rsi
DEFAULT_BAR_LIMIT=250
# Paper order size in USD
DEFAULT_NOTIONAL=100
