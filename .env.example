# Alpaca API credentials.
# Use paper API keys while developing.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Safety defaults. Orders are disabled unless both values below allow it.
TRADING_MODE=alerts_only
PLACE_ORDERS=false

# Optional Telegram alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Strategy defaults.
DEFAULT_SYMBOL=AAPL
DEFAULT_ASSET_CLASS=stock
DEFAULT_TIMEFRAME=1Day
DEFAULT_BAR_LIMIT=250
DEFAULT_NOTIONAL=100
